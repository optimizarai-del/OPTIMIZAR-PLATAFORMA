SECRET_KEY=optimizar-secret-key-change-in-production-2026

# ── GitHub Integration ────────────────────────────────────────────────────────
# Opcional: token para repositorios privados (Settings → Developer settings → Personal access tokens)
GITHUB_TOKEN=

# ── IA / Claude ───────────────────────────────────────────────────────────────
# Obtenelo en https://console.anthropic.com/
ANTHROPIC_API_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./optimizar.db
CORS_ORIGINS=http://localhost:5800,http://localhost:5173,http://localhost:3000

# ── Email / Notificaciones ────────────────────────────────────────────────────
# Poner NOTIFICATIONS_ENABLED=true para activar el envío real de emails.
# Para Gmail: activar "Contraseñas de aplicación" en tu cuenta Google
# y usar esa contraseña de 16 caracteres en SMTP_PASSWORD.
NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
FROM_NAME=Optimizar IA
FROM_EMAIL=tu@gmail.com
APP_URL=http://localhost:5800
