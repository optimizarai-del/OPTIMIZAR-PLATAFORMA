SECRET_KEY=optimizar-secret-key-change-in-production-2026

# ── CRM: endpoint externo ─────────────────────────────────────────────────────
# Clave para autenticar POST /api/crm/external/oportunidades (header X-API-Key).
# Generá una aleatoria, p.ej.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si queda vacía, el endpoint externo responde 503 (deshabilitado).
EXTERNAL_API_KEY=

# ── GitHub Integration ────────────────────────────────────────────────────────
# Opcional: token para repositorios privados (Settings → Developer settings → Personal access tokens)
GITHUB_TOKEN=

# ── IA / Claude ───────────────────────────────────────────────────────────────
# Obtenelo en https://console.anthropic.com/
ANTHROPIC_API_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Base de datos ─────────────────────────────────────────────────────────────
# Producción (Supabase Postgres - Transaction pooler, puerto 6543):
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-X-region.pooler.supabase.com:6543/postgres
# Conseguilo en Supabase → tu proyecto → botón "Connect" → URI → Transaction pooler
#
# Desarrollo local con SQLite:
#   sqlite:///./optimizar.db
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-us-west-2.pooler.supabase.com:6543/postgres

CORS_ORIGINS=http://localhost:5800,http://localhost:5173,http://localhost:3000

# ── Email / Notificaciones ────────────────────────────────────────────────────
# Poner NOTIFICATIONS_ENABLED=true para activar el envío real de emails.
# Para Gmail: activar "Contraseñas de aplicación" en tu cuenta Google
# y usar esa contraseña de 16 caracteres en SMTP_PASSWORD.
NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
FROM_NAME=Optimizar IA
FROM_EMAIL=tu@gmail.com
APP_URL=http://localhost:5800

# ── Equipo de Venta y Prospección ─────────────────────────────────────────────
# Destinatarios de los reportes/alertas del funnel (separados por coma).
FUNNEL_NOTIFY_EMAILS=rodriguezfederico765@gmail.com,optimizar.ai@gmail.com

# ── Outreach automático (envío + escucha en código, reemplaza n8n) ────────────
# Activar SOLO en producción. Reusa SMTP_* de arriba para enviar; IMAP para escuchar.
OUTREACH_ENABLED=false
OUTREACH_FROM_NAME=OPTIMIZAR
OUTREACH_FROM_EMAIL=          # vacío = usa SMTP_USER
OUTREACH_DAILY_CAP=30         # tope de envíos por corrida (warm-up: arrancar en 10-15)
OUTREACH_THROTTLE_SEC=90      # espera entre envíos
OUTREACH_SEND_HOUR=9          # hora del envío diario
OUTREACH_INBOX_EVERY_MIN=10   # cada cuántos minutos revisa el inbox
OUTREACH_TZ=America/Argentina/Buenos_Aires
# IMAP del mismo buzón de Hostinger (para leer respuestas)
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993

# ── Chat en vivo: dispara al orquestador (routine en el plan) al recibir un mensaje ──
# CLAUDE_ROUTINE_FIRE_URL: la "URL de activación" de la routine chat-responder
#   (panel claude.ai/code/routines → routine → Activación por API → termina en /fire).
# CLAUDE_ROUTINE_TOKEN: el token durable de esa misma activación.
# SELF_API_BASE: URL PÚBLICA de ESTE backend (la misma que usa VITE_API_URL del frontend),
#   para que la routine pueda postear la respuesta de vuelta. NO la URL interna de docker.
CLAUDE_ROUTINE_FIRE_URL=
CLAUDE_ROUTINE_TOKEN=
SELF_API_BASE=
